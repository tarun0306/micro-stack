# AWS RDS PostgreSQL connection for the Account Service.
# Do not commit real credentials or endpoints to this file.
ORDER_DATABASE_URL=postgres://DB_USER:DB_PASSWORD@YOUR_RDS_ENDPOINT:5432/order?sslmode=verify-full&sslrootcert=/certs/global-bundle.pem
OPENSEARCH_URL=https://YOUR_OPENSEARCH_ENDPOINT
ACCOUNT_DATABASE_URL=postgres://USER:PASSWORD@YOUR_RDS_ENDPOINT:5432/account?sslmode=verify-full&sslrootcert=/certs/global-bundle.pem
